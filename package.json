{
    "name": "valiant-credit-protocol",
    "version": "1.0.0",
    "private": true,
    "description": "Delegated credit protocol lab for local Hardhat testing.",
    "scripts": {
        "build": "hardhat compile",
        "test": "hardhat test",
        "test:trace": "hardhat test --show-stack-traces",
