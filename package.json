        "fmt": "prettier --write .prettierignore '**/*.{ts,js,json,yml}'"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-toolbox": "^5.0.0",
        "hardhat": "^3.12.0"
    }
}
